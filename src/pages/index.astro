---
import Base from '../layouts/Base.astro';
import RainRiver from '../components/figures/RainRiver.astro';
import Email from '../components/Email.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import headshot from '../assets/headshot.jpg';

const me = (await getEntry('profile', 'me'))!.data;
const featured = (await getCollection('projects', (p) => p.data.featured && p.data.visibility === 'public'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const interests = (await getCollection('interests')).sort((a, b) => a.data.order - b.data.order);

const photo = await getImage({ src: headshot, width: 400, height: 400, format: 'jpg' });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: me.name,
  url: Astro.site?.href,
  jobTitle: 'Civil engineer',
  homeLocation: { '@type': 'Place', name: me.location },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Tribhuvan University, IOE Thapathali Campus' },
  knowsAbout: interests.map((i) => i.data.label),
  sameAs: me.links.map((l) => l.href),
  image: new URL(photo.src, Astro.site).href,
};
---

<Base description={me.statement} jsonLd={[person]}>
  <section class="hero-scroll" data-hero-scroll aria-labelledby="hero-title">
    <div class="hero-sticky mx-auto grid max-w-page items-center gap-x-12 gap-y-10 px-4 sm:px-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Image src={headshot} alt={`Portrait of ${me.name}`} width={112} height={112} loading="eager" class="hero-photo" />
        <p class="eyebrow">{me.location}</p>
        <h1 id="hero-title" class="hero-title">{me.name}</h1>
        <p class="hero-role">{me.role}</p>
        <p class="hero-lede">{me.statement}</p>
        <ul class="hero-actions">
          <li><a href="#work">Selected work</a></li>
          <li><a href="/cv.pdf">CV (PDF)</a></li>
          <li><Email address={me.email} label="Email" /></li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <RainRiver />
      </div>
    </div>
  </section>

  <section id="work" class="mx-auto mt-20 max-w-page px-4 sm:px-8" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <a href="/work/">All projects</a>
    </div>
    <ol class="work-list">
      {featured.map((p, i) => (
        <li class="work-row">
          <span class="work-idx">{String(i + 1).padStart(2, '0')}</span>
          <div class="work-main">
            <h3><a href={`/work/${p.id}/`}>{p.data.title}</a></h3>
            <p class="work-status">{p.data.status}{p.data.role && ` · ${p.data.role}`}</p>
          </div>
          <p class="work-summary">{p.data.summary}</p>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero-scroll { position: relative; }
  .hero-sticky { padding-block: 3.5rem 2rem; }
  /* Enabled by the figure script on desktop when motion is allowed. */
  .hero-scroll:global(.is-scrub) { height: 200vh; }
  .hero-scroll:global(.is-scrub) .hero-sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    padding-block: 2rem;
  }

  .hero-photo {
    display: block;
    width: 112px;
    height: 112px;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-sm);
    object-fit: cover;
    object-position: 50% 30%;
    outline: 1px solid var(--c-rule);
    outline-offset: 3px;
  }
  @media (max-width: 639px) { .hero-photo { width: 88px; height: 88px; } }
  .eyebrow {
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  .hero-title {
    margin-top: 0.75rem;
    font-size: clamp(var(--text-3xl), 5.2vw, var(--text-5xl));
    line-height: var(--leading-tight);
    font-weight: 430;
    letter-spacing: -0.02em;
  }
  .hero-role {
    margin-top: 0.75rem;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--c-ink-2);
  }
  .hero-lede {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--text-base);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.75rem;
    font-family: var(--font-jbmono);
    font-size: var(--text-sm);
  }
  .hero-actions a {
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-accent);
    padding-bottom: 0.125rem;
  }
  .hero-actions a:hover { color: var(--c-accent-text); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--c-ink);
  }
  .section-head h2 { font-size: var(--text-xl); font-weight: 480; }
  .section-head a { font-family: var(--font-jbmono); font-size: var(--text-sm); color: var(--c-ink-2); }

  .work-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--c-rule);
  }
  @media (min-width: 900px) {
    .work-row { grid-template-columns: 3rem 5fr 6fr; gap: 2rem; }
  }
  .work-idx {
    font-family: var(--font-jbmono);
    font-size: var(--text-sm);
    color: var(--c-accent-text);
    padding-top: 0.3rem;
  }
  .work-main h3 { font-size: var(--text-lg); line-height: var(--leading-snug); font-weight: 500; }
  .work-main h3 a { color: var(--c-ink); text-decoration: none; }
  .work-main h3 a:hover { text-decoration: underline; text-decoration-color: var(--c-accent); text-underline-offset: 4px; }
  .work-status {
    margin-top: 0.375rem;
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    color: var(--c-ink-2);
  }
  .work-summary { grid-column: 2; color: var(--c-ink-2); }
  @media (min-width: 900px) { .work-summary { grid-column: 3; } }
</style>
