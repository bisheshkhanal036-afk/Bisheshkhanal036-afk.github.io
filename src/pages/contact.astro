---
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
const me = (await getEntry('profile', 'me'))!.data;
---

<Base title="Contact" description={`How to reach ${me.name}.`}>
  <article class="mx-auto max-w-page px-4 pt-14 sm:px-8">
    <div class="contact-head">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Email is the best way to reach me.</h1>
      </div>
      <Image src={headshot} alt={`Portrait of ${me.name}`} width={220} height={220} class="contact-photo" />
    </div>
    <dl class="contact">
      <dt>Email</dt>
      <dd><Email address={me.email} class="big" /></dd>
      {me.links.map((l) => (
        <>
          <dt>{l.label}</dt>
          <dd><a href={l.href} rel="me">{l.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></dd>
        </>
      ))}
      <dt>CV</dt>
      <dd><a href="/cv.pdf">cv.pdf</a> or the <a href="/cv/">web version</a></dd>
      <dt>Based in</dt>
      <dd>{me.location}</dd>
    </dl>
  </article>
</Base>

<style>
  .contact-head { display: flex; flex-wrap: wrap-reverse; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .contact-photo { width: 220px; height: 220px; border-radius: var(--radius-sm); object-fit: cover; object-position: 50% 30%; outline: 1px solid var(--c-rule); outline-offset: 3px; }
  @media (max-width: 639px) { .contact-photo { width: 140px; height: 140px; } }
  .eyebrow {
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  h1 {
    margin-top: 0.5rem;
    max-width: 30ch;
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 430;
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }
  .contact {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-ink);
    max-width: 44rem;
  }
  dt {
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-ink-2);
    padding-top: 0.35rem;
  }
  dd { margin: 0; overflow-wrap: anywhere; }
  dd a { color: var(--c-ink); text-decoration-color: var(--c-accent); text-underline-offset: 4px; }
  dd :global(.big) { font-size: var(--text-lg); }
</style>
