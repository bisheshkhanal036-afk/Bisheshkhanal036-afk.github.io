---
/**
 * Case-study page. `public`: summary, facts, body, figure (when its data exists), links.
 * `minimal`: title, status and role only, as Bishesh asked. Hidden projects get no page.
 */
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import aims from '../../data/aims.json';
import { listedProjects, listedInterests, listedPublications, statusLine } from '../../lib/content';
import SurrogateFigure from '../../components/figures/SurrogateFigure.astro';
import IsolationFigure from '../../components/figures/IsolationFigure.astro';
import SwipeFigure from '../../components/figures/SwipeFigure.astro';
import TwoModelsFigure from '../../components/figures/TwoModelsFigure.astro';
import LayersFigure from '../../components/figures/LayersFigure.astro';
import RainfallFigure from '../../components/figures/RainfallFigure.astro';

const FIGURES = { SurrogateFigure, IsolationFigure, SwipeFigure, TwoModelsFigure, LayersFigure, RainfallFigure };

export async function getStaticPaths() {
  const projects = await listedProjects();
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const isPublic = d.visibility === 'public';
const { Content } = await render(project);
const interests = (await listedInterests()).filter((i) => d.interests.some((r) => r.id === i.id));
const pubs = (await listedPublications()).filter((p) => p.data.project?.id === project.id);

const all = await listedProjects();
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];

const aim = (aims.projects as Record<string, { text: string }>)[project.id]?.text;
const description = isPublic ? d.summary : `${d.title}. ${d.status}.`;
const fmtFact = (f: (typeof d.facts)[number]) => `${f.value}${f.unit ? (f.unit === '%' ? '' : ' ') + f.unit : ''}`;
---

<Base title={d.title} description={description}>
  <article class="mx-auto max-w-page px-4 pt-14 sm:px-8">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/work/">Work</a> <span aria-hidden="true">/</span> <span aria-current="page">{String(idx + 1).padStart(2, '0')}</span></nav>

    <header class="cs-head">
      <h1>{d.title}</h1>
      <dl class="cs-meta">
        <div><dt>Status</dt><dd>{d.status}</dd></div>
        {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        <div><dt>Period</dt><dd>{d.period}</dd></div>
      </dl>
    </header>

    {isPublic && d.figures.length > 0 && (
      <div class="cs-figures">
        {d.figures.map((f) => {
          const Fig = FIGURES[f.component];
          return <Fig />;
        })}
      </div>
    )}

    {isPublic && (
      <div class="cs-grid">
        <div class="cs-text">
          <p class="cs-summary">{d.summary}</p>
          {aim && <div class="cs-aim"><p class="cs-aim-k">Why it matters</p><p>{aim}</p></div>}
          <div class="prose"><Content /></div>
        </div>

        <aside class="cs-side" aria-label="Project facts">
          {d.facts.length > 0 && (
            <section>
              <h2>Facts</h2>
              <dl class="facts">
                {d.facts.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>
                      {f.source === 'PLACEHOLDER' ? <span class="ph">PLACEHOLDER</span> : fmtFact(f)}
                      {f.qualifier && <span class="qual">{f.qualifier}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
          {d.stack.length > 0 && (
            <section>
              <h2>Methods and tools</h2>
              <p class="stack">{d.stack.join(', ')}</p>
            </section>
          )}
          {interests.length > 0 && (
            <section>
              <h2>Research interests</h2>
              <ul class="ilinks">
                {interests.map((i) => <li><a href={`/work/?interest=${i.id}`}>{i.data.label}</a></li>)}
              </ul>
            </section>
          )}
          {(d.links.length > 0 || pubs.length > 0) && (
            <section>
              <h2>Links</h2>
              <ul class="ilinks">
                {d.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
                {pubs.filter((p) => !d.links.some((l) => p.data.doi && l.href.includes(p.data.doi))).map((p) => <li><a href={`/publications/#${p.id}`}>Manuscript: {statusLine(p.data)}</a></li>)}
              </ul>
            </section>
          )}
        </aside>
      </div>
    )}

    <nav class="cs-next" aria-label="Next project">
      <span>Next</span>
      <a href={`/work/${next.id}/`}>{next.data.title}</a>
    </nav>
  </article>
</Base>

<style>
  .crumb { font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-ink-2); }
  .crumb a { color: var(--c-ink-2); }
  .cs-head { padding-bottom: 2rem; border-bottom: 1px solid var(--c-ink); }
  h1 {
    margin-top: 1rem;
    max-width: 24ch;
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 430;
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }
  .cs-meta { display: flex; flex-wrap: wrap; gap: 0.75rem 2.5rem; margin-top: 1.5rem; }
  .cs-meta dt, .cs-side h2 {
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  .cs-meta dd { margin: 0.25rem 0 0; }

  .cs-figures { display: grid; gap: 4.5rem; margin-top: 2.5rem; max-width: 60rem; }
  .cs-grid { display: grid; gap: 3rem; margin-top: 3.5rem; }
  @media (min-width: 900px) { .cs-grid { grid-template-columns: 7fr 4fr; gap: 4rem; } }
  .cs-summary { font-size: var(--text-lg); line-height: var(--leading-snug); max-width: 38rem; }
  .cs-aim { margin-top: 1.75rem; max-width: 38rem; padding: 1rem 1.25rem; border-left: 3px solid var(--c-accent); background: var(--c-paper-2); }
  .cs-aim-k { font-family: var(--font-jbmono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-accent-text); }
  .cs-aim p + p { margin-top: 0.375rem; }
  .prose { margin-top: 1.5rem; max-width: 38rem; }
  .prose :global(h2) { margin-top: 2.5rem; font-size: var(--text-xl); font-weight: 480; }
  .prose :global(p) { margin-top: 1rem; }

  .cs-side section + section { margin-top: 2rem; }
  .cs-side h2 { padding-bottom: 0.5rem; border-bottom: 1px solid var(--c-rule); }
  .facts div { display: grid; grid-template-columns: 1fr auto; gap: 1rem; padding-block: 0.5rem; border-bottom: 1px dashed var(--c-rule); }
  .facts dt { font-size: var(--text-sm); color: var(--c-ink-2); }
  .facts dd { margin: 0; text-align: right; font-family: var(--font-jbmono); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .qual { display: block; font-size: var(--text-xs); color: var(--c-accent-text); }
  .ph { padding: 0 0.25rem; background: var(--c-accent-wash); color: var(--c-accent-text); font-size: var(--text-xs); }
  .stack { margin-top: 0.75rem; font-size: var(--text-sm); color: var(--c-ink-2); }
  .ilinks { margin-top: 0.75rem; display: grid; gap: 0.5rem; font-size: var(--text-sm); }
  .ilinks a { color: var(--c-ink); text-decoration-color: var(--c-accent); text-underline-offset: 3px; }

  .cs-next {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-rule);
  }
  .cs-next span { font-family: var(--font-jbmono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-ink-2); }
  .cs-next a { font-size: var(--text-lg); color: var(--c-ink); text-decoration-color: var(--c-accent); text-underline-offset: 4px; }
</style>
