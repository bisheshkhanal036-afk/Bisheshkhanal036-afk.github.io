---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StageGauge from '../components/StageGauge.astro';

interface Props {
  title?: string;
  description: string;
  /** JSON-LD objects to embed. */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, jsonLd = [], ogImage = '/og.png' } = Astro.props;
const fullTitle = title ? `${title} · Bishesh Khanal` : 'Bishesh Khanal · Flood modelling and early warning';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13181b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-jbmono" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    <!-- Marks JS as available so figures can start from frame 0. If figure code has not
         reported ready within 4 s, the class is removed and the static final frames show. -->
    <script is:inline data-astro-rerun>
      document.documentElement.classList.add('js');
      clearTimeout(window.__jsGuard);
      window.__jsGuard = setTimeout(() => {
        if (!window.__figuresReady) document.documentElement.classList.remove('js');
      }, 4000);
    </script>
    <ClientRouter />
  </head>
  <body class="bg-paper text-ink min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <StageGauge />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    left: 1rem;
    top: 0.75rem;
    z-index: var(--z-skip);
    padding: 0.5rem 0.875rem;
    background: var(--c-ink);
    color: var(--c-paper);
    font-family: var(--font-jbmono);
    font-size: var(--text-sm);
    transform: translateY(-200%);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .skip-link:focus { transform: none; }
</style>
