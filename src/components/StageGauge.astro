---
/**
 * Reading progress drawn as a river-stage gauge on the right edge.
 * Fill rises from the bottom as the page scrolls. CSS scroll-driven animation where
 * supported; a passive, rAF-throttled script sets the needle and readout everywhere.
 * Decorative (aria-hidden): progress is not information a reader needs.
 * Mobile: collapses to a thin line.
 */
const ticks = Array.from({ length: 21 }, (_, i) => i); // 0.0 … 10.0 in 0.5 steps
---

<div class="gauge" aria-hidden="true">
  <div class="gauge-track">
    {ticks.map((i) => <span class:list={['tick', { major: i % 4 === 0 }]} style={`bottom:${(i / 20) * 100}%`}>{i % 4 === 0 && <em>{(i / 2).toFixed(0)}</em>}</span>)}
    <span class="fill"></span>
    <span class="needle"></span>
  </div>
  <span class="readout"><span class="lbl">stage</span> <span class="val">0.0</span></span>
</div>

<style>
  .gauge {
    position: fixed;
    right: 0.875rem;
    top: 18vh;
    bottom: 12vh;
    z-index: var(--z-gauge);
    width: 2.25rem;
    pointer-events: none;
    font-family: var(--font-jbmono);
    color: var(--c-ink-2);
  }
  .gauge-track {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 2rem;
    width: 2px;
    background: var(--c-rule);
  }
  .tick {
    position: absolute;
    right: 2px;
    width: 6px;
    height: 1px;
    background: var(--c-rule-strong);
  }
  .tick.major { width: 12px; background: var(--c-ink-2); }
  .tick em {
    position: absolute;
    right: 16px;
    top: -0.45em;
    font-style: normal;
    font-size: 0.625rem;
    line-height: 1;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: var(--c-accent);
    transform-origin: bottom;
    transform: scaleY(var(--p, 0));
  }
  .needle {
    position: absolute;
    right: -3px;
    bottom: 0;
    width: 18px;
    height: 2px;
    background: var(--c-accent);
    transform: translateY(calc(var(--p, 0) * var(--h, 0px) * -1));
  }
  .readout {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .readout .val { color: var(--c-ink); }

  @supports (animation-timeline: scroll()) {
    .fill {
      animation: gauge-fill linear both;
      animation-timeline: scroll(root block);
    }
    @keyframes gauge-fill {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }
  }

  /* Below 1280px there is no margin for ticks: thin line only. */
  @media (max-width: 1279px) {
    .gauge { right: 0; top: 0; bottom: 0; width: 3px; }
    .gauge-track { bottom: 0; width: 3px; background: transparent; }
    .tick, .needle, .readout { display: none; }
  }
</style>

<script>
  let raf = 0;
  function update() {
    raf = 0;
    const g = document.querySelector<HTMLElement>('.gauge');
    if (!g) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    const track = g.querySelector<HTMLElement>('.gauge-track')!;
    g.style.setProperty('--p', p.toFixed(4));
    g.style.setProperty('--h', `${track.clientHeight}px`);
    g.querySelector('.val')!.textContent = (p * 10).toFixed(1);
  }
  const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule, { passive: true });
  document.addEventListener('astro:page-load', schedule);
</script>
