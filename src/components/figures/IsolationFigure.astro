---
/**
 * Fig. 3, Bagmati: "Isolation". Scrub through a flood hydrograph; hexes flood as the
 * stage rises, building hexes that can no longer reach a shelter turn "isolated", the
 * shelter service area contracts and two example routes lengthen. No counts are shown:
 * the manuscript's results stay off the site while it is under review.
 */
import FigureShell from './FigureShell.astro';
import { buildWorld, W, H } from '../../lib/schematic/catchment-world';
import { pathFrom } from '../../lib/schematic/noise';

const w = buildWorld();
const rest = w.steps[w.peakStep];
const cls = { f: 'iso-f', i: 'iso-i', r: 'iso-r', d: 'iso-d' } as const;

// Hydrograph strip
const SH = 120, sx0 = 52, sx1 = W - 16, sTop = 14, sBase = 92;
const T = w.hydro.flow.length;
const sx = (t: number) => sx0 + (t / T) * (sx1 - sx0);
const sy = (q: number) => sBase - (q / w.hydro.peak) * (sBase - sTop);
const hydroD = pathFrom([[sx(0), sy(0)], ...w.hydro.flow.map((q, i) => [sx(i + 1), sy(q)] as [number, number])]);
const payload = JSON.stringify({
  codes: w.steps.map((s) => s.code),
  service: w.steps.map((s) => s.service),
  routes: w.steps.map((s) => s.routes),
  t: w.steps.map((s) => s.t),
  T,
  peak: w.peakStep,
});

const description =
  'A stand-in catchment is tiled with hexagons. As the flood stage rises with the hydrograph, low hexes near the channel flood. ' +
  'Breadth-first search from three shelters through dry hexes marks which building hexes can still reach safety; the rest become isolated. ' +
  'The outline of the shelter service area shrinks and two example evacuation routes detour around the water, then recover as the flood recedes. ' +
  'All data is synthetic and shows the method only; the manuscript results are not shown.';
---

<FigureShell
  id="fig-isolation"
  number={3}
  title="Isolation"
  caption="Scrub through the flood. Building hexes that keep a dry path to a shelter stay reachable; the rest are isolated. The shelter service area contracts and evacuation routes lengthen. The method follows the manuscript; the geometry and values here are synthetic."
  data="synthetic catchment, hydrograph and building density; to be replaced with aggregated Bagmati model output"
  status="schematic"
  description={description}
  synthetic
  class="iso"
>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Catchment hex map: flooded, isolated and reachable building areas" data-iso-map>
    <path d={w.outline} class="iso-outline" />
    <g data-hexes>
      {w.hexes.map((h, i) => <path d={h.d} class={cls[rest.code[i] as keyof typeof cls]} />)}
    </g>
    <path d={w.river} class="iso-river" />
    <path d={w.steps[0].service} class="iso-service-base" />
    <path d={rest.service} class="iso-service" data-service />
    {w.steps[0].routes.map((d) => <path d={d} class="iso-route-base" />)}
    {rest.routes.map((d, k) => <path d={d} class="iso-route" data-route={k} />)}
    {w.routeOrigins.map((id) => {
      const h = w.hexes[id];
      return <circle cx={h.x} cy={h.y} r="4" class="iso-origin" />;
    })}
    {w.shelters.map((id) => {
      const h = w.hexes[id];
      return <path d={`M${h.x},${h.y - 8}L${h.x + 7},${h.y + 5}L${h.x - 7},${h.y + 5}Z`} class="iso-shelter" />;
    })}
  </svg>

  <svg class="iso-hydro" viewBox={`0 0 ${W} ${SH}`} role="img" aria-label="Flood hydrograph with the current time marked">
    <text class="chart-label" x={0} y={sTop - 2}>discharge</text>
    <line class="chart-axis" x1={sx0} x2={sx1} y1={sBase} y2={sBase} />
    <path d={hydroD} class="iso-hline" />
    <line data-cursor class="iso-cursor" x1={sx(rest.t)} x2={sx(rest.t)} y1={sTop} y2={sBase} />
    <text class="chart-label" x={sx1} y={sBase + 20} text-anchor="end">time</text>
  </svg>

  <ul class="fig-key" aria-hidden="true">
    <li><span class="sw iso-f-sw"></span>flooded</li>
    <li><span class="sw iso-i-sw"></span>buildings cut off</li>
    <li><span class="sw iso-r-sw"></span>buildings that can reach a shelter</li>
    <li><span class="sw iso-shelter-sw"></span>shelter</li>
    <li><span class="sw sw-line iso-svc-sw"></span>service area</li>
    <li><span class="sw sw-line iso-route-sw"></span>route now, dashed before the flood</li>
  </ul>
  <script type="application/json" data-iso-data set:html={payload} />
</FigureShell>

<style is:global>
  .iso-outline { fill: var(--c-paper-2); stroke: var(--chart-label); stroke-width: 1.25; }
  .iso-d { fill: transparent; }
  .iso-f { fill: color-mix(in srgb, var(--chart-water-hi) 75%, var(--chart-water-lo)); }
  .iso-r { fill: color-mix(in srgb, var(--chart-ink) 22%, var(--c-paper-2)); }
  .iso-i { fill: var(--chart-model); }
  [data-hexes] path { stroke: var(--c-paper); stroke-width: 0.75; transition: fill var(--duration-fast) linear; }
  .iso-river { fill: none; stroke: var(--chart-water-hi); stroke-width: 2.5; }
  .iso-service { fill: none; stroke: var(--chart-ink); stroke-width: 1.75; }
  .iso-service-base { fill: none; stroke: var(--chart-ink); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.45; }
  .iso-route { fill: none; stroke: var(--chart-ink); stroke-width: 2.5; stroke-linejoin: round; }
  .iso-route-base { fill: none; stroke: var(--chart-ink); stroke-width: 1.25; stroke-dasharray: 4 3; opacity: 0.6; }
  .iso-origin { fill: var(--c-paper); stroke: var(--chart-ink); stroke-width: 2; }
  .iso-shelter { fill: var(--chart-ink); stroke: var(--c-paper); stroke-width: 1.5; }
  .iso-hydro { margin-top: 0.5rem; }
  .iso-hline { fill: none; stroke: var(--chart-water-hi); stroke-width: 2; }
  .iso-cursor { stroke: var(--chart-model); stroke-width: 2; }
  .iso-f-sw { background: color-mix(in srgb, var(--chart-water-hi) 75%, var(--chart-water-lo)); }
  .iso-i-sw { background: var(--chart-model); }
  .iso-r-sw { background: color-mix(in srgb, var(--chart-ink) 22%, var(--c-paper-2)); }
  .iso-shelter-sw { background: var(--chart-ink); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .iso-svc-sw, .iso-route-sw { background: var(--chart-ink); }
  @media (max-width: 639px) { .iso .chart-label { font-size: 18px; } }
</style>

<script>
  import { mountIsolation } from './isolation';
  document.addEventListener('astro:page-load', () => {
    const fig = document.getElementById('fig-isolation');
    if (fig) mountIsolation(fig);
  });
</script>
