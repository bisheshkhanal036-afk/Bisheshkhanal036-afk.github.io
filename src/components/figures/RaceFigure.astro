---
/**
 * Fig. 2, Hanumante: "The race". Left, a 2D depth grid fills cell by cell as a physical
 * model would, on a wall clock that runs past one hour. Right, the surrogate returns
 * discharge at 21 cross-sections in seconds. Below, one event's hydrograph from both.
 * All geometry and series are synthetic (seeded) until the project data is supplied.
 */
import FigureShell from './FigureShell.astro';
import { blobOutline, fbm, pathFrom, pointInPolygon, mulberry32 } from '../../lib/schematic/noise';
import { runoff } from '../../lib/hydro/scs';

const SEED = 2031;
const PW = 320, PH = 250; // each map panel
const basin = blobOutline(SEED, PW / 2, PH / 2 + 4, 138, 100, 80, 0.2);
const noise = fbm(SEED + 7, 3);

// River centreline: meanders across the basin, west to east.
const river: [number, number][] = Array.from({ length: 60 }, (_, i) => {
  const t = i / 59;
  return [34 + t * 252, PH / 2 + 18 * Math.sin(t * 5.2) + 26 * (noise(t * 3, 1.3) - 0.5) - 10 * t];
});
const riverD = pathFrom(river);
const seglen = river.slice(1).map((p, i) => Math.hypot(p[0] - river[i][0], p[1] - river[i][1]));
const total = seglen.reduce((a, b) => a + b, 0);
function along(f: number): [number, number] {
  let d = f * total;
  for (let i = 0; i < seglen.length; i++) {
    if (d <= seglen[i]) {
      const k = d / seglen[i];
      return [river[i][0] + (river[i + 1][0] - river[i][0]) * k, river[i][1] + (river[i + 1][1] - river[i][1]) * k];
    }
    d -= seglen[i];
  }
  return river.at(-1)!;
}
const sections = Array.from({ length: 21 }, (_, i) => along(0.04 + (i / 20) * 0.92));

// Depth grid: wet cells near the river, deeper closer to it.
const COLS = 30, ROWS = 23, cw = PW / COLS, ch = PH / ROWS;
const distToRiver = (x: number, y: number) => Math.min(...river.map(([rx, ry]) => Math.hypot(rx - x, ry - y)));
const cells: { x: number; y: number; band: number; at: number }[] = [];
for (let r = 0; r < ROWS; r++) {
  for (let c = 0; c < COLS; c++) {
    const x = (c + 0.5) * cw, y = (r + 0.5) * ch;
    if (!pointInPolygon([x, y], basin)) continue;
    const d = distToRiver(x, y);
    const depth = 1 - d / 58 + 0.35 * (noise(x / 40, y / 40) - 0.5);
    if (depth < 0.12) continue;
    const band = Math.min(3, Math.floor(depth * 4));
    // Fill order follows distance from the channel, with some solver-like irregularity.
    const at = Math.min(0.97, 0.03 + 0.8 * (d / 58) + 0.14 * noise(x / 25 + 9, y / 25));
    cells.push({ x: c * cw, y: r * ch, band, at });
  }
}

// One event at one cross-section: reference run vs surrogate (both synthetic).
const rain = [0, 1, 3, 6, 11, 16, 12, 8, 5, 3, 2, 1, 0.5, 0, 0, 0];
const ref = runoff(rain, 0.5, { areaKm2: 60, curveNumber: 82, tcHours: 2.5 });
const rnd = mulberry32(SEED + 3);
const sur = ref.flow.map((q, i) => Math.max(0, q * (1 + 0.06 * Math.sin(i / 2.7) + 0.04 * (rnd() - 0.5))));
const HW = 640, HH = 222, hx0 = 52, hx1 = HW - 16, hTop = 40, hBase = 182;
const T = ref.flow.length * 0.5;
const qMax = Math.ceil((Math.max(...ref.flow, ...sur) * 1.1) / 30) * 30;
const hx = (t: number) => hx0 + (t / T) * (hx1 - hx0);
const hy = (q: number) => hBase - (q / qMax) * (hBase - hTop);
const line = (s: number[]) => pathFrom([[hx(0), hy(0)], ...s.map((q, n) => [hx((n + 1) * 0.5), hy(q)] as [number, number])]);
const tTicks = [0, 6, 12, 18, 24].filter((t) => t <= T);
const qTicks = [0, qMax / 2, qMax];

const description =
  'Two panels share one clock. On the left, a two-dimensional depth grid over a stand-in basin fills cell by cell, starting at the channel, while the solver clock runs past one hour. ' +
  'On the right, the surrogate network returns discharge at all 21 cross-sections along the river almost at once. ' +
  'Below, one synthetic flood event at a single cross-section, with the reference run and the surrogate drawn together. All data in this figure is synthetic.';
---

<FigureShell
  id="fig-race"
  number={2}
  title="The race"
  caption="A 2D hydraulic model fills its grid over more than an hour of computing. A trained GRU surrogate returns discharge at the 21 cross-sections in seconds. Below, one event at one cross-section from both."
  data="synthetic basin, river and event generated for illustration; to be replaced with the Hanumante model output"
  status="schematic"
  description={description}
  synthetic
  class="race"
>
  <div class="race-panels">
    <div class="race-panel">
      <p class="race-title">Physical model <span>HEC-RAS 2D</span></p>
      <svg viewBox={`0 0 ${PW} ${PH}`} role="img" aria-label="Physical model depth grid filling over time" data-race-grid>
        <path d={pathFrom(basin, true)} class="race-basin" />
        <g>
          {cells.map((c) => <rect x={c.x + 0.4} y={c.y + 0.4} width={cw - 0.8} height={ch - 0.8} class={`race-cell b${c.band}`} data-at={c.at.toFixed(3)} />)}
        </g>
        <path d={riverD} class="race-river" />
      </svg>
      <div class="race-clock">
        <span class="race-clock-label">solver clock</span>
        <span class="race-clock-val" data-phys-clock>1:05:00</span>
      </div>
      <div class="race-bar" aria-hidden="true"><span class="race-bar-fill" data-phys-bar></span><span class="race-bar-hour" style={`left:${(60 / 65) * 100}%`}>1 h</span></div>
    </div>

    <div class="race-panel">
      <p class="race-title">Surrogate <span>GRU network</span></p>
      <svg viewBox={`0 0 ${PW} ${PH}`} role="img" aria-label="Surrogate predictions at 21 cross-sections" data-race-sur>
        <path d={pathFrom(basin, true)} class="race-basin" />
        <path d={riverD} class="race-river" />
        {sections.map(([x, y], i) => (
          <g class="race-xs" data-xs={i} transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
            <circle r="9" class="race-xs-ring" />
            <circle r="3.6" class="race-xs-dot" />
          </g>
        ))}
        <text class="chart-label" x={PW - 6} y={PH - 8} text-anchor="end">21 cross-sections</text>
      </svg>
      <div class="race-clock">
        <span class="race-clock-label">surrogate</span>
        <span class="race-clock-val" data-sur-clock>done in seconds</span>
      </div>
    </div>
  </div>

  <svg class="race-hydro" viewBox={`0 0 ${HW} ${HH}`} role="img" aria-label="Hydrograph at one cross-section: reference run and surrogate" data-race-hydro>
    <defs><clipPath id="race-clip"><rect data-hclip x={hx0} y={0} width={hx1 - hx0} height={HH} /></clipPath></defs>
    <text class="chart-label" x={0} y={hTop - 22}>discharge, m³/s</text>
    {qTicks.map((v) => (
      <g>
        <line class="chart-grid" x1={hx0} x2={hx1} y1={hy(v)} y2={hy(v)} />
        <text class="chart-label" x={hx0 - 8} y={hy(v) + 4} text-anchor="end">{Math.round(v)}</text>
      </g>
    ))}
    <g clip-path="url(#race-clip)">
      <path d={line(ref.flow)} class="race-ref" />
      <path d={line(sur)} class="race-sur" />
    </g>
    <line class="chart-axis" x1={hx0} x2={hx1} y1={hBase} y2={hBase} />
    {tTicks.map((t) => <text class="chart-label" x={hx(t)} y={hBase + 16} text-anchor="middle">{t}</text>)}
    <text class="chart-label" x={hx1} y={hBase + 34} text-anchor="end">event time, hours</text>
  </svg>
  <ul class="fig-key" aria-hidden="true">
    <li><span class="sw sw-line race-ref-sw"></span>2D model, reference run</li>
    <li><span class="sw sw-line race-sur-sw"></span>GRU surrogate</li>
    <li><span class="sw race-wet-sw"></span>wet cell, darker is deeper</li>
  </ul>
</FigureShell>

<style is:global>
  .race-panels { display: grid; gap: 1.5rem; }
  @media (min-width: 640px) { .race-panels { grid-template-columns: 1fr 1fr; } }
  .race-title { font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-ink); margin-bottom: 0.375rem; }
  .race-title span { color: var(--c-ink-2); margin-left: 0.5rem; }
  .race-basin { fill: var(--c-paper-2); stroke: var(--chart-label); stroke-width: 1; }
  .race-river { fill: none; stroke: var(--chart-water-hi); stroke-width: 2.5; stroke-linecap: round; }
  .race-cell.b0 { fill: color-mix(in srgb, var(--chart-water-hi) 20%, var(--chart-water-lo)); }
  .race-cell.b1 { fill: color-mix(in srgb, var(--chart-water-hi) 45%, var(--chart-water-lo)); }
  .race-cell.b2 { fill: color-mix(in srgb, var(--chart-water-hi) 70%, var(--chart-water-lo)); }
  .race-cell.b3 { fill: var(--chart-water-hi); }
  .race-xs-ring { fill: none; stroke: var(--chart-model); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .race-xs-dot { fill: var(--chart-model); stroke: var(--c-paper); stroke-width: 1.5; }
  .race-xs.is-hit .race-xs-ring { animation: race-pulse 900ms var(--ease-out) 1; }
  @keyframes race-pulse { from { opacity: 1; transform: scale(0.4); } to { opacity: 0; transform: scale(1.6); } }

  .race-clock { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.5rem; font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-ink-2); }
  .race-clock-val { color: var(--c-ink); font-variant-numeric: tabular-nums; }
  .race-bar { position: relative; height: 4px; margin-top: 0.375rem; background: var(--c-rule); }
  .race-bar-fill { position: absolute; inset: 0; background: var(--chart-water-hi); transform-origin: left; }
  .race-bar-hour { position: absolute; top: -3px; width: 1px; height: 10px; background: var(--c-ink); font-family: var(--font-jbmono); font-size: 0.625rem; line-height: 1; text-indent: 4px; padding-top: 12px; color: var(--c-ink-2); white-space: nowrap; }

  .race-hydro { margin-top: 2.25rem; }
  .race-ref { fill: none; stroke: var(--chart-ink); stroke-width: 2; }
  .race-sur { fill: none; stroke: var(--chart-model); stroke-width: 2; stroke-dasharray: 5 3; }
  [data-hclip] { transform-box: fill-box; transform-origin: left center; }

  .fig-key { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-top: 0.5rem; font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-ink-2); }
  .fig-key li { display: flex; align-items: center; gap: 0.5rem; }
  .fig-key .sw { display: inline-block; width: 0.75rem; height: 0.75rem; }
  .fig-key .sw-line { height: 2px; }
  .race-ref-sw { background: var(--chart-ink); }
  .race-sur-sw { background: var(--chart-model); }
  .race-wet-sw { background: color-mix(in srgb, var(--chart-water-hi) 45%, var(--chart-water-lo)); }

  /* Frame 0 when JS runs; without JS the final frame shows. */
  .js .race-cell { opacity: 0; }
  .js [data-phys-bar] { transform: scaleX(0); }
  .js [data-hclip] { transform: scaleX(0); }
  .js .race-xs-dot { opacity: 0.25; }

  @media (max-width: 639px) {
    .race .race-hydro .chart-label { font-size: 20px; }
  }
</style>

<script>
  import { mountRace } from './race';
  document.addEventListener('astro:page-load', () => {
    const fig = document.getElementById('fig-race');
    if (fig) mountRace(fig);
  });
</script>
