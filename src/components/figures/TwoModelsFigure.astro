---
/**
 * Fig. 5, Kaligandaki: "Two models, one river". A reference discharge series draws in,
 * then a process-based (SWAT) and a machine-learning (XGBoost) simulation overlay it,
 * then input-importance (SHAP) bars grow. Until the preprint's own series, metrics and
 * SHAP values are supplied, every value is synthetic and no skill metric is shown.
 */
import FigureShell from './FigureShell.astro';
import { fbm, mulberry32, pathFrom } from '../../lib/schematic/noise';

const SEED = 919;
const n = 365;
const rnd = mulberry32(SEED);
const wig = fbm(SEED + 5, 3);
// Monsoon-shaped year: low winter flow, June–September high flow with storm spikes.
const ref: number[] = [];
for (let d = 0; d < n; d++) {
  const season = Math.exp(-(((d - 215) / 45) ** 2));
  const spike = rnd() < 0.05 && season > 0.3 ? 0.6 * rnd() * season : 0;
  const prev = ref[d - 1] ?? 0.12;
  ref.push(Math.max(0.08, 0.6 * prev + 0.4 * (0.12 + 0.95 * season + 0.15 * wig(d / 20, 1)) + spike));
}
// Two simulations with different, comparable errors: one smooth and lagged, one noisy.
const modelA = ref.map((_, d) => {
  const lag = ref[Math.max(0, d - 4)];
  const k = Math.max(0, d - 10);
  return 0.6 * lag + 0.4 * ref.slice(k, d + 1).reduce((a, b) => a + b, 0) / (d - k + 1);
});
const modelB = ref.map((q) => Math.max(0.05, q * (1 + 0.22 * (wig(q * 9, 7) - 0.5) * 2)));

const W = 640, H = 250, x0 = 40, x1 = W - 12, top = 18, base = 210;
const qMax = Math.max(...ref, ...modelA, ...modelB) * 1.05;
const X = (d: number) => x0 + (d / (n - 1)) * (x1 - x0);
const Y = (q: number) => base - (q / qMax) * (base - top);
const series = (s: number[]) => pathFrom(s.map((q, d) => [X(d), Y(q)]));
const months = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];

// Input importance: generic labels until the preprint's inputs are supplied.
const shap = [0.92, 0.61, 0.44, 0.3, 0.19, 0.11].map((v, i) => ({ label: `input ${i + 1}`, v }));
const BW = 640, BH = 196, bx0 = 92, bx1 = BW - 20, bRow = 28;

const description =
  'A year of daily discharge with a monsoon peak. A reference series draws in first; a smooth, slightly late process-based simulation and a closer but noisier machine-learning simulation then overlay it. ' +
  'Below, bars rank six model inputs by mean absolute SHAP value. Every value is synthetic, inputs are unnamed, and no skill metric is reported here; the preprint holds the real comparison.';
---

<FigureShell
  id="fig-two-models"
  number={5}
  title="Two models, one river"
  caption="Daily discharge for one year: a reference series, then a process-based (SWAT) and a machine-learning (XGBoost) simulation over it. Below, SHAP ranks the inputs the machine-learning model relies on. The preprint's figures and metrics will replace these stand-ins."
  data="synthetic series and SHAP values; to be replaced with values from the preprint (doi:10.31223/x55n3n)"
  status="schematic"
  description={description}
  synthetic
  class="tm"
>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Reference discharge with two model simulations" data-tm>
    <defs>
      <clipPath id="tm-c0"><rect data-tm-clip="0" x={x0} y="0" width={x1 - x0} height={H} /></clipPath>
      <clipPath id="tm-c1"><rect data-tm-clip="1" x={x0} y="0" width={x1 - x0} height={H} /></clipPath>
      <clipPath id="tm-c2"><rect data-tm-clip="2" x={x0} y="0" width={x1 - x0} height={H} /></clipPath>
    </defs>
    <text class="chart-label" x={0} y={top - 6}>discharge (relative)</text>
    <line class="chart-axis" x1={x0} x2={x1} y1={base} y2={base} />
    {months.map((m, i) => <text class="chart-label" x={X((i + 0.5) * (n / 12))} y={base + 16} text-anchor="middle">{m}</text>)}
    <g clip-path="url(#tm-c0)"><path d={series(ref)} class="tm-ref" /></g>
    <g clip-path="url(#tm-c1)"><path d={series(modelA)} class="tm-a" /></g>
    <g clip-path="url(#tm-c2)"><path d={series(modelB)} class="tm-b" /></g>
  </svg>
  <ul class="fig-key" aria-hidden="true">
    <li><span class="sw sw-line tm-ref-sw"></span>reference series</li>
    <li><span class="sw sw-line tm-a-sw"></span>SWAT, process-based</li>
    <li><span class="sw sw-line tm-b-sw"></span>XGBoost, machine learning</li>
  </ul>

  <svg class="tm-shap" viewBox={`0 0 ${BW} ${BH}`} role="img" aria-label="Input importance by mean absolute SHAP value">
    <text class="chart-label" x={0} y={12}>mean |SHAP|, XGBoost</text>
    {shap.map((s, i) => (
      <g transform={`translate(0 ${30 + i * bRow})`}>
        <text class="chart-label" x={bx0 - 10} y={13} text-anchor="end">{s.label}</text>
        <rect x={bx0} y={2} width={(bx1 - bx0) * s.v} height={bRow - 10} class="tm-bar" data-bar={i} />
      </g>
    ))}
  </svg>
</FigureShell>

<style is:global>
  .tm-ref { fill: none; stroke: var(--chart-ink); stroke-width: 1.75; }
  .tm-a { fill: none; stroke: var(--chart-model-2); stroke-width: 1.75; }
  .tm-b { fill: none; stroke: var(--chart-model); stroke-width: 1.5; }
  .tm-ref-sw { background: var(--chart-ink); }
  .tm-a-sw { background: var(--chart-model-2); }
  .tm-b-sw { background: var(--chart-model); }
  .tm-shap { margin-top: 1.5rem; }
  .tm-bar { fill: var(--chart-model); transform-box: fill-box; transform-origin: left center; }
  [data-tm-clip] { transform-box: fill-box; transform-origin: left center; }
  .js [data-tm-clip], .js .tm-bar { transform: scaleX(0); }
  @media (max-width: 639px) { .tm .chart-label { font-size: 18px; } }
</style>

<script>
  import { mountScrub, seg } from '../../lib/motion/scrub';
  document.addEventListener('astro:page-load', () => {
    const fig = document.getElementById('fig-two-models');
    if (!fig) return;
    const clips = [...fig.querySelectorAll<SVGRectElement>('[data-tm-clip]')];
    const bars = [...fig.querySelectorAll<SVGRectElement>('.tm-bar')];
    const phases = [[0, 0.35], [0.35, 0.55], [0.55, 0.75]] as const;
    mountScrub({
      fig,
      playSeconds: 8,
      start: 'top 75%',
      end: 'bottom 45%',
      clock: (p) => (p < 0.35 ? 'reference' : p < 0.55 ? '+ SWAT' : p < 0.75 ? '+ XGBoost' : 'SHAP'),
      render: (p) => {
        clips.forEach((c, i) => { c.style.transform = `scaleX(${seg(p, phases[i][0], phases[i][1]).toFixed(4)})`; });
        bars.forEach((b, i) => { b.style.transform = `scaleX(${seg(p, 0.75 + i * 0.03, 0.88 + i * 0.02).toFixed(4)})`; });
      },
    });
  });
</script>
