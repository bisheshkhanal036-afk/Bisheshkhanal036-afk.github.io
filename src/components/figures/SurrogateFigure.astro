---
/**
 * Fig. 2, Hanumante: "Surrogate against the 2D model". Real run output
 * (src/data/hanumante/surrogate.json, from scripts/data/surrogate_csv_to_json.py).
 * One held-out test event, chosen by a fixed rule (median skill). Pick any of the 21
 * cross-sections; the hydrograph shows the HEC-RAS 2D reference and the GRU's 3-hour-ahead
 * prediction against that section's warning levels. Both series are model output: simulated.
 */
import FigureShell from './FigureShell.astro';
import data from '../../data/hanumante/surrogate.json';

const secs = data.sections;
const DEFAULT = secs.length - 1;
const W = 640, H = 300, x0 = 52, x1 = W - 16, top = 34, base = 252;
const n = secs[0].qRef.length;
const yMax = Math.ceil((Math.max(...secs.flatMap((s) => [...s.qRef, ...s.qPred, s.thresholds.danger])) * 1.04) / 20) * 20;
const X = (t: number) => x0 + (t / (n - 1)) * (x1 - x0);
const Y = (q: number) => base - (q / yMax) * (base - top);
const path = (s: number[]) => 'M' + s.map((q, t) => `${X(t).toFixed(1)},${Y(q).toFixed(1)}`).join('L');
const tTicks = [0, 12, 24, 36, 48, 60].filter((t) => t < n);
const qTicks = Array.from({ length: 5 }, (_, i) => Math.round((yMax / 4) * i));
const s0 = secs[DEFAULT];
const levels = [
  { key: 'watch', label: 'Watch P75' },
  { key: 'warning', label: 'Warning P90' },
  { key: 'danger', label: 'Danger P97' },
] as const;

// Section strip: NSE for this event at each section. Axis 0.8 to 1.0, labelled as truncated.
const NSE_LO = 0.8;
const barH = (v: number) => Math.max(2, ((Math.max(v, NSE_LO) - NSE_LO) / (1 - NSE_LO)) * 100);

const sign = (v: number) => (v > 0 ? `+${v}` : `${v}`);
const statLine = (s: (typeof secs)[number]) =>
  `NSE ${s.nse.toFixed(3)} · KGE ${s.kge.toFixed(3)} · peak ${sign(s.peakErrPct)}% · timing ${sign(s.timeErrH)} h`;

const description =
  `Discharge over ${n} hours of held-out test event ${data.event.id} at ${s0.name}. The HEC-RAS 2D reference peaks at ${Math.max(...s0.qRef).toFixed(1)} m³/s; ` +
  `the GRU surrogate's ${data.leadHours}-hour-ahead prediction peaks ${Math.abs(s0.peakErrPct)}% ${s0.peakErrPct < 0 ? 'lower' : 'higher'}, with NSE ${s0.nse}. ` +
  `The flow passes the Watch and Warning levels but stays below Danger. Across the 21 cross-sections, NSE for this event ranges from ${Math.min(...secs.map((s) => s.nse))} to ${Math.max(...secs.map((s) => s.nse))}. ` +
  `The event was chosen by rule: its mean NSE (${data.event.meanNse}) is the median of the ${data.run.test} held-out test events, whose means range from ${data.event.rangeOfTestEvents[0]} to ${data.event.rangeOfTestEvents[1]}.`;
---

<FigureShell
  id="fig-surrogate"
  number={2}
  title="Surrogate against the 2D model"
  caption={`Discharge at one cross-section during a held-out test event: the HEC-RAS 2D run the network was trained to reproduce, and the GRU surrogate's ${data.leadHours}-hour-ahead prediction. Choose any of the 21 cross-sections. Dashed lines are that section's Watch, Warning and Danger levels. The event is the test event with median skill, not the best one. The 2D model needs over an hour per event; the surrogate answers in seconds.`}
  data={`HEC-RAS 2D and GRU surrogate output, run GRU_surrogate_leadtime3_12864 (June 2026), test event ${data.event.id} of ${data.run.test} held out`}
  status="simulated"
  description={description}
  class="sg"
>
  <div class="sg-strip" role="group" aria-label="Cross-section: NSE for this event at each of the 21 sections">
    <div class="sg-axis" aria-hidden="true"><span>1.00</span><span>0.90</span><span>0.80</span></div>
    <div class="sg-bars">
      {secs.map((s, i) => (
        <button type="button" class="sg-bar" data-sec={i} aria-pressed={i === DEFAULT ? 'true' : 'false'} aria-label={`${s.name}, NSE ${s.nse}`}>
          <span class="sg-bar-fill" style={`height:${barH(s.nse).toFixed(1)}%`}></span>
          <span class="sg-bar-num" aria-hidden="true">{s.name.replace('Profile Line ', '')}</span>
        </button>
      ))}
    </div>
    <p class="sg-strip-cap" aria-hidden="true">NSE for this event by profile line (axis starts at 0.80)</p>
  </div>

  <p class="sg-title"><span data-sg-name>{s0.name}</span><span class="sg-stats" data-sg-stats>{statLine(s0)}</span></p>

  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Hydrograph: HEC-RAS 2D reference and GRU prediction with warning levels" data-sg>
    <defs><clipPath id="sg-clip"><rect data-sg-clip x={x0} y="0" width={x1 - x0} height={H} /></clipPath></defs>
    <text class="chart-label" x={0} y={top - 20}>discharge, m³/s</text>
    {qTicks.map((v) => (
      <g>
        <line class="chart-grid" x1={x0} x2={x1} y1={Y(v)} y2={Y(v)} />
        <text class="chart-label" x={x0 - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
      </g>
    ))}
    {levels.map((l) => (
      <g data-level={l.key} transform={`translate(0 ${Y(s0.thresholds[l.key]).toFixed(1)})`}>
        <line class={`sg-level sg-${l.key}`} x1={x0} x2={x1} y1="0" y2="0" />
        <text class="chart-label sg-level-label" x={x1 - 4} y="-5" text-anchor="end">{l.label}</text>
      </g>
    ))}
    <g clip-path="url(#sg-clip)">
      <path d={path(s0.qRef)} class="sg-ref" data-sg-ref />
      <path d={path(s0.qPred)} class="sg-pred" data-sg-pred />
    </g>
    <line class="chart-axis" x1={x0} x2={x1} y1={base} y2={base} />
    {tTicks.map((t) => <text class="chart-label" x={X(t)} y={base + 16} text-anchor="middle">{t}</text>)}
    <text class="chart-label" x={x1} y={base + 34} text-anchor="end">hours into the event</text>
  </svg>
  <ul class="fig-key" aria-hidden="true">
    <li><span class="sw sw-line sg-ref-sw"></span>HEC-RAS 2D (reference)</li>
    <li><span class="sw sw-line sg-pred-sw"></span>GRU surrogate, {data.leadHours} h ahead</li>
    <li><span class="sw sw-line sg-lvl-sw"></span>warning levels for this section</li>
  </ul>
</FigureShell>

<style is:global>
  .sg-strip { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0 0.5rem; margin-bottom: 1.25rem; }
  .sg-axis { display: flex; flex-direction: column; justify-content: space-between; height: 72px; font-family: var(--font-jbmono); font-size: 0.625rem; color: var(--c-ink-2); text-align: right; }
  .sg-bars { display: grid; grid-template-columns: repeat(21, 1fr); gap: 3px; align-items: end; }
  .sg-bar { position: relative; display: flex; flex-direction: column; justify-content: flex-end; height: 92px; padding: 0 0 20px; border: 0; background: transparent; cursor: pointer; }
  .sg-bar-fill { display: block; width: 100%; background: var(--chart-water-hi); opacity: 0.55; transition: opacity var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out); }
  .sg-bar:hover .sg-bar-fill { opacity: 0.85; }
  .sg-bar[aria-pressed='true'] .sg-bar-fill { background: var(--chart-model); opacity: 1; }
  .sg-bar-num { position: absolute; bottom: 2px; left: 0; right: 0; font-family: var(--font-jbmono); font-size: 0.625rem; color: var(--c-ink-2); text-align: center; }
  .sg-bar[aria-pressed='true'] .sg-bar-num { color: var(--c-ink); font-weight: 600; }
  .sg-strip-cap { grid-column: 2; font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-ink-2); }
  .sg-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; margin-bottom: 0.25rem; font-family: var(--font-jbmono); font-size: var(--text-sm); color: var(--c-ink); }
  .sg-stats { font-size: var(--text-xs); color: var(--c-ink-2); font-variant-numeric: tabular-nums; }
  .sg-ref { fill: none; stroke: var(--chart-ink); stroke-width: 2; stroke-linejoin: round; }
  .sg-pred { fill: none; stroke: var(--chart-model); stroke-width: 2; stroke-dasharray: 5 3; stroke-linejoin: round; }
  .sg-level { stroke: var(--chart-label); stroke-width: 1; stroke-dasharray: 2 4; }
  .sg-danger { stroke: var(--chart-ink); }
  .sg-level-label { paint-order: stroke; stroke: var(--c-paper); stroke-width: 4px; }
  .sg-ref-sw { background: var(--chart-ink); }
  .sg-pred-sw { background: var(--chart-model); }
  .sg-lvl-sw { background: var(--chart-label); }
  [data-sg-clip] { transform-box: fill-box; transform-origin: left center; }
  .js [data-sg-clip] { transform: scaleX(0); }
  @media (max-width: 639px) {
    .sg .chart-label { font-size: 17px; }
    .sg-bar-num { font-size: 0.5rem; }
    .sg-bars { gap: 1px; }
  }
</style>

<script>
  import { mountSurrogate } from './surrogate';
  document.addEventListener('astro:page-load', () => {
    const fig = document.getElementById('fig-surrogate');
    if (fig) mountSurrogate(fig);
  });
</script>
