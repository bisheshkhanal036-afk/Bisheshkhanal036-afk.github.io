---
/**
 * Every animated figure sits in this shell:
 * - caption in paper style: "Fig. N. What it shows. Data: … Status: …"
 * - play/pause + scrubber (hidden until the figure script enables them)
 * - a text description of what the figure shows, for everyone, not only screen readers
 * The slot holds the build-time final frame, so the figure reads correctly without JS.
 */
interface Props {
  id: string;
  number: number | string;
  title: string;
  caption: string;
  data: string;
  status: 'observed' | 'simulated' | 'schematic';
  description: string;
  /** Data generated in code as a stand-in until the project's real data is supplied. */
  synthetic?: boolean;
  class?: string;
}
const { id, number, title, caption, data, status, description, synthetic = false, class: className } = Astro.props;
---

<figure class:list={['fig', className]} id={id} data-figure aria-labelledby={`${id}-cap`}>
  {synthetic && <p class="fig-synthetic">Synthetic stand-in, not project results</p>}
  <div class="fig-graphic">
    <slot />
  </div>

  <div class="fig-controls" data-controls hidden>
    <button type="button" class="fig-btn" data-play aria-pressed="false">
      <span data-play-label>Play</span>
    </button>
    <label class="fig-scrub">
      <span class="sr-only">Scrub {title}</span>
      <input type="range" min="0" max="1000" step="1" value="1000" data-scrub />
    </label>
    <output class="fig-clock" data-clock-out aria-live="off"></output>
  </div>

  <figcaption id={`${id}-cap`} class="fig-caption">
    <span class="fig-num">Fig. {number}.</span> <strong>{title}.</strong> {caption}
    <span class="fig-meta">
      <span>Data: {data}</span>
      <span class:list={['fig-status', `is-${status}`]}>Status: {status}</span>
    </span>
  </figcaption>

  <details class="fig-desc">
    <summary>What this figure shows</summary>
    <p>{description}</p>
  </details>
</figure>

<style is:global>
  .fig { margin: 0; }
  .fig-synthetic {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--c-rule-strong);
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--c-ink);
  }
  .fig-graphic svg { display: block; width: 100%; height: auto; overflow: visible; }
  .fig-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
  }
  .fig-controls[hidden] { display: none; }
  .fig-btn {
    min-width: 4.5rem;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--c-rule-strong);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--c-ink);
    font: inherit;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .fig-btn:hover { border-color: var(--c-ink); }
  .fig-scrub { flex: 1; display: flex; }
  .fig-scrub input { width: 100%; accent-color: var(--c-accent); min-height: 2rem; }
  .fig-clock { min-width: 6.5ch; text-align: right; color: var(--c-ink-2); font-variant-numeric: tabular-nums; }

  .fig-caption {
    margin-top: 0.875rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--c-ink-2);
    max-width: 42rem;
  }
  .fig-caption strong { color: var(--c-ink); font-weight: 600; }
  .fig-num {
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--c-ink);
  }
  .fig-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.375rem;
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
  }
  .fig-status.is-schematic { color: var(--c-ink); }
  .fig-desc { margin-top: 0.5rem; font-size: var(--text-sm); color: var(--c-ink-2); max-width: 42rem; }
  .fig-desc summary {
    cursor: pointer;
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    color: var(--c-ink-2);
    width: fit-content;
  }
  .fig-desc p { margin-top: 0.375rem; }

  /* Shared SVG chart styles: every figure uses these */
  .chart-axis { stroke: var(--chart-label); stroke-width: 1; fill: none; }
  .chart-grid { stroke: var(--chart-grid); stroke-width: 1; fill: none; }
  .chart-label {
    fill: var(--chart-label);
    font-family: var(--font-jbmono);
    font-size: 11px;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .chart-label.strong { fill: var(--chart-ink); }
  .chart-schematic-tag {
    fill: var(--chart-ink);
    font-family: var(--font-jbmono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
