---
/**
 * Fig. 1, home hero: "Rain becomes river".
 * A schematic storm is turned into runoff with SCS curve-number losses and convolved
 * with the SCS dimensionless unit hydrograph (src/lib/hydro/scs.ts). The final frame is
 * rendered here at build time; the script below only reveals it over a simulation clock.
 */
import FigureShell from './FigureShell.astro';
import { runoff } from '../../lib/hydro/scs';
import hero from '../../data/hero-schematic.json';

const h = runoff(hero.rainMm, hero.dtHours, hero.catchment);
const T = hero.durationHours;

// Layout (SVG user units)
const W = 640, H = 456;
const x0 = 52, x1 = W - 20;
const rainTop = 34, rainDepth = 116;
const qTop = 222, qBase = 392;
const x = (t: number) => x0 + (t / T) * (x1 - x0);

const rainMax = 20; // mm per step, axis max
const rY = (mm: number) => (mm / rainMax) * rainDepth;
const qStep = Math.ceil((h.peakFlow * 1.1) / 3 / 10) * 10;
const qMax = qStep * 3;
const qY = (q: number) => qBase - (q / qMax) * (qBase - qTop);

const bars = h.rain.map((p, m) => ({
  t: m * h.dtHours,
  x: x(m * h.dtHours) + 0.75,
  w: x(h.dtHours) - x0 - 1.5,
  hp: rY(p),
  he: rY(h.excess[m]),
}));

const pts: [number, number][] = [[x(0), qY(0)], ...h.flow.map((q, n) => [x((n + 1) * h.dtHours), qY(q)] as [number, number])];
const line = 'M' + pts.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join('L');
const area = `${line}L${pts.at(-1)![0].toFixed(1)},${qBase}L${x(0)},${qBase}Z`;

const centroid = h.peakTimeHours - h.lagHours;
const xc = x(centroid), xp = x(h.peakTimeHours), yp = qY(h.peakFlow);
const timeTicks = [0, 6, 12, 18, 24, 30];
const qTicks = [0, qStep, 2 * qStep, qMax];
const rainTicks = [0, 10, 20];

const fmt = (v: number, d = 1) => v.toFixed(d);
const description =
  `A ${fmt(h.totalRainMm, 0)} mm storm falls over ${fmt(h.rain.length * h.dtHours, 0)} hours in half-hour steps, peaking at ${Math.max(...h.rain)} mm in one step. ` +
  `Curve-number losses (CN ${hero.catchment.curveNumber}) leave ${fmt(h.totalExcessMm)} mm of excess rainfall. ` +
  `Convolved with the unit hydrograph of a ${hero.catchment.areaKm2} km² catchment with a ${hero.catchment.tcHours}-hour time of concentration, ` +
  `discharge rises to a peak of ${fmt(h.peakFlow, 0)} m³/s at hour ${fmt(h.peakTimeHours)}, ${fmt(h.lagHours)} hours after the centroid of excess rainfall, and recedes over the following day.`;
---

<FigureShell
  id="fig-rain-river"
  number={1}
  title="Rain becomes river"
  caption={`A storm on a schematic ${hero.catchment.areaKm2} km² catchment. Curve-number losses (CN ${hero.catchment.curveNumber}) give excess rainfall, which is convolved with the SCS dimensionless unit hydrograph (time of concentration ${hero.catchment.tcHours} h, 30-minute steps). The hydrograph is computed, not drawn.`}
  data="schematic storm and catchment, no observations"
  status="schematic"
  description={description}
  class="rr"
>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="fig-rain-river-cap" data-rr data-total={T} data-dt={h.dtHours} data-peak-t={h.peakTimeHours}>
    <defs>
      <clipPath id="rr-clip">
        <rect data-clip x={x0} y={qTop - 30} width={x1 - x0} height={qBase - qTop + 31} />
      </clipPath>
    </defs>

    <text class="chart-schematic-tag" x={x1} y={14} text-anchor="end">SCHEMATIC</text>

    <!-- Hyetograph: bars hang from the top axis -->
    <text class="chart-label" x={0} y={rainTop - 16}>rainfall, mm per 30 min</text>
    {rainTicks.map((v) => (
      <g>
        <line class="chart-grid" x1={x0} x2={x1} y1={rainTop + rY(v)} y2={rainTop + rY(v)} />
        <text class="chart-label" x={x0 - 8} y={rainTop + rY(v) + 4} text-anchor="end">{v}</text>
      </g>
    ))}
    <g class="rr-bars">
      {bars.map((b) => (
        <g data-bar data-t={b.t}>
          <rect x={b.x} y={rainTop} width={b.w} height={b.hp} class="rr-rain" />
          {b.he > 0 && <rect x={b.x} y={rainTop} width={b.w} height={b.he} class="rr-excess" />}
        </g>
      ))}
    </g>
    <line class="chart-axis" x1={x0} x2={x1} y1={rainTop} y2={rainTop} />

    <!-- Hydrograph -->
    <text class="chart-label" x={0} y={qTop - 18}>discharge, m³/s</text>
    {qTicks.map((v) => (
      <g>
        <line class="chart-grid" x1={x0} x2={x1} y1={qY(v)} y2={qY(v)} />
        <text class="chart-label" x={x0 - 8} y={qY(v) + 4} text-anchor="end">{v}</text>
      </g>
    ))}
    <g clip-path="url(#rr-clip)">
      <path d={area} class="rr-area" />
      <path d={line} class="rr-line" />
    </g>

    <!-- Peak and lag, revealed when the clock passes the peak -->
    <g data-at={h.peakTimeHours} class="rr-annot">
      <line class="rr-guide" x1={xc} x2={xc} y1={rainTop} y2={qBase} />
      <line class="rr-guide" x1={xp} x2={xp} y1={yp} y2={qBase} />
      <line class="rr-lag" x1={xc} x2={xp} y1={qTop - 4} y2={qTop - 4} />
      <line class="rr-lag" x1={xc} x2={xc} y1={qTop - 8} y2={qTop} />
      <line class="rr-lag" x1={xp} x2={xp} y1={qTop - 8} y2={qTop} />
      <text class="chart-label strong" x={xp + 8} y={qTop - 1}>lag {fmt(h.lagHours)} h</text>
      <circle cx={xp} cy={yp} r="4" class="rr-peak" />
      <text class="chart-label strong" x={xp + 10} y={yp + 18}>peak {fmt(h.peakFlow, 0)} m³/s at {fmt(h.peakTimeHours)} h</text>
    </g>

    <!-- Time axis and clock cursor -->
    <line class="chart-axis" x1={x0} x2={x1} y1={qBase} y2={qBase} />
    {timeTicks.map((t) => (
      <g>
        <line class="chart-axis" x1={x(t)} x2={x(t)} y1={qBase} y2={qBase + 5} />
        <text class="chart-label" x={x(t)} y={qBase + 18} text-anchor="middle">{t}</text>
      </g>
    ))}
    <text class="chart-label" x={x1} y={qBase + 46} text-anchor="end">time, hours</text>
    <line data-cursor class="rr-cursor" x1={x0} x2={x0} y1={rainTop} y2={qBase} />
  </svg>
  <ul class="rr-key" aria-hidden="true">
    <li><span class="sw rr-rain-sw"></span>rainfall lost to infiltration</li>
    <li><span class="sw rr-excess-sw"></span>excess rainfall, becomes runoff</li>
    <li><span class="sw rr-line-sw"></span>discharge at the outlet</li>
  </ul>
</FigureShell>

<style is:global>
  .rr-rain { fill: var(--chart-water-lo); }
  .rr-excess { fill: var(--chart-water-hi); }
  .rr-area { fill: var(--c-accent-wash); opacity: 0.6; }
  .rr-line { fill: none; stroke: var(--chart-model); stroke-width: 2.25; stroke-linejoin: round; }
  .rr-peak { fill: var(--chart-model); stroke: var(--c-paper); stroke-width: 2; }
  .rr-guide { stroke: var(--chart-label); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.7; }
  .rr-lag { stroke: var(--chart-ink); stroke-width: 1.25; }
  .rr-cursor { stroke: var(--chart-ink); stroke-width: 1; opacity: 0; }

  /* With JS, start at frame 0. Without JS (or if the script fails), the final frame stays. */
  [data-rr] [data-bar] { transform-box: fill-box; transform-origin: top center; }
  .js [data-rr] [data-bar] { opacity: 0; transform: scaleY(0); }
  .js [data-rr] [data-clip] { transform: scaleX(0); }
  .js [data-rr] [data-at] { opacity: 0; }
  [data-rr] [data-clip] { transform-box: fill-box; transform-origin: left center; }
  [data-rr] [data-at] { transition: opacity var(--duration-base) var(--ease-out); }
  [data-rr].is-live .rr-cursor { opacity: 0.35; }

  .rr-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
    font-family: var(--font-jbmono);
    font-size: var(--text-xs);
    color: var(--c-ink-2);
  }
  .rr-key li { display: flex; align-items: center; gap: 0.5rem; }
  .rr-key .sw { display: inline-block; width: 0.75rem; height: 0.75rem; }
  .rr-rain-sw { background: var(--chart-water-lo); }
  .rr-excess-sw { background: var(--chart-water-hi); }
  .rr-line-sw { height: 2px !important; background: var(--chart-model); }

  /* Phone width: the 640-unit chart renders at about half size, so labels double. */
  @media (max-width: 639px) {
    .rr .chart-label { font-size: 20px; }
    .rr .chart-schematic-tag { font-size: 17px; }
    .rr .rr-peak { r: 7px; }
    .rr .rr-line { stroke-width: 3.5; }
  }
</style>

<script>
  import { mountRainRiver } from './rain-river';
  document.addEventListener('astro:page-load', () => {
    const fig = document.getElementById('fig-rain-river');
    if (fig) mountRainRiver(fig);
  });
</script>
