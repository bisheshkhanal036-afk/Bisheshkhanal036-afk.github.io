---
/**
 * Fig. 6, FloodHUB: the tool's eight steps on one real run (HydroBASINS level 8 basin
 * 4080848980, run of 2026-08-25). Each step has its own move on one map stage:
 *   1 Area of interest   the basin outline draws, then fills; area counts up
 *   2 Criteria           eleven layers deal onto a tilted stack, each named as it lands
 *   3 Weighting          gaps open in proportion to weight; light layers fade; bars grow
 *   4 Compute            the stack drops together and the risk surface develops under a scan line
 *   5 Vulnerability      the map flattens; hazard classes appear one by one; table counts up
 *   6 Validate           cells holding BIPAD flood incidents pop in; success curve draws
 *   7 Compare to METEOR  METEOR's flooded area spreads over the classes; bars grow
 *   8 Shelters           exposure grid; the screening funnel narrows 610,329 -> 20
 * All numbers come from steps.json / layers.json (FloodHUB's own functions on its cache).
 * Without JS the steps read as an ordered list beside the hazard-class map.
 */
import FigureShell from './FigureShell.astro';
import FloodChart from './FloodChart.astro';
import { buildLayers, HAZARD_RGB } from '../../lib/schematic/floodhub-layers';

const { W, H, criteria, hazardPng, classPngs, exposurePng, outline, bipadCells, meta, steps } = buildLayers();
const pct = (w: number, d = 1) => `${(w * 100).toFixed(d)}%`;
const int = (n: number) => n.toLocaleString('en-GB');
const cached = meta.source.match(/cached (\d{4}-\d{2}-\d{2})/)?.[1] ?? '';
const zonal = steps.report.zonal.filter((z) => z.areaKm2 > 0);
const areaKm2 = zonal.reduce((a, z) => a + z.areaKm2, 0);
const val = steps.validation[0];
const met = steps.meteor;
const sh = steps.shelters;
const eligible = sh.totalBuildings - sh.excludedTooSmall - sh.excludedHighHazard - sh.excludedNoData;
const rgb = (c: number[]) => `rgb(${c.join(' ')})`;
const maxFrac = Math.max(...met.byClass.map((b) => b.fraction ?? 0));
const wMax = criteria[0].weight;
const funnel = [
  { n: sh.totalBuildings, label: 'buildings in the basin' },
  { n: sh.totalBuildings - sh.excludedTooSmall, label: `with a footprint of ${sh.minFootprintM2} m² or more` },
  { n: sh.totalBuildings - sh.excludedTooSmall - sh.excludedHighHazard, label: 'outside high hazard' },
  { n: eligible, label: 'with complete data' },
  { n: sh.candidates, label: 'shortlisted as shelters' },
];
const logW = (n: number) => (Math.log10(n) / Math.log10(sh.totalBuildings)) * 100;

const STEPS = [
  'Area of interest', 'Criteria', 'Weighting', 'Compute',
  'Vulnerability report', 'Validate', 'Compare to METEOR', 'Shelters',
];

const description =
  `FloodHUB's eight steps on one run for a basin of ${areaKm2.toFixed(0)} km² containing the Kathmandu Valley. ` +
  `Eleven criteria are reclassified into five classes and combined with AHP weights; distance to river (${pct(criteria[0].weight)}) and elevation (${pct(criteria[1].weight)}) weigh most. ` +
  `The risk surface is split into hazard classes: ${zonal.map((z) => `${z.label} ${z.areaKm2.toFixed(0)} km² with ${int(z.buildings)} buildings`).join('; ')}. No cell reaches Very High. ` +
  `Against the ${val.observedCells} grid cells holding BIPAD flood incidents (2011 to 2026) the success-rate AUC is ${val.auc}; against METEOR's 1-in-100-year river flood it is ${met.auc}, and the flooded share rises from Low to High class. ` +
  `Of ${int(sh.totalBuildings)} buildings, ${int(eligible)} pass the shelter screens and ${sh.candidates} are shortlisted.`;
---

<FigureShell
  id="fig-layers"
  number={6}
  title="Eight steps, one basin"
  caption={`FloodHUB's workflow run end to end on a HydroBASINS level 8 basin (ID ${meta.aoi.hybasId}) containing the Kathmandu Valley. Scroll, or press a step. Weights are those of the run from ${cached}; change them at step 3 to recompute the surface, while steps 5 to 8 show the run's own results. Maps are averaged to ${meta.aoi.resolutionM} m cells; FloodHUB works at ${meta.grid.nativeResolutionM} m.`}
  data={`FloodHUB run of ${cached} (Copernicus GLO-30, ESA WorldCover, Sentinel-2, CHIRPS, HRSL, OpenStreetMap, BIPAD, METEOR); credits below`}
  status="simulated"
  description={description}
  class="ly"
>
  <div class="ly-pin" data-ly-pin>
    <div class="ly-sticky">
      <ol class="ly-rail" aria-label="FloodHUB steps">
        {STEPS.map((s, i) => (
          <li><button type="button" data-ly-go={i} aria-current={i === 4 ? 'step' : undefined}><span class="ly-rail-bar"><span class="ly-rail-fill" data-ly-fill={i}></span></span><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{s}</span></button></li>
        ))}
      </ol>

      <div class="ly-grid">
        <div class="ly-stage">
          <div class="ly-stack" data-ly-stack style={`aspect-ratio:${W}/${H}`}>
            {criteria.map((_, i) => (
              <img class="ly-plane ly-layer" width={W} height={H} alt="" data-ly-layer={i} />
            ))}
            <canvas class="ly-plane ly-canvas" width={W} height={H} data-ly-canvas aria-hidden="true"></canvas>
            <img class="ly-plane ly-hazard-all" src={hazardPng} width={W} height={H} alt="Hazard classes across the basin" data-ly-hazard-all />
            {classPngs.map((c) => <img class="ly-plane ly-class" src={c.src} width={W} height={H} alt="" data-ly-class={c.k} />)}
            <canvas class="ly-plane ly-meteor" width={W} height={H} data-ly-meteor aria-hidden="true"></canvas>
            <img class="ly-plane ly-expo" src={exposurePng} width={W} height={H} alt="" data-ly-expo />
            <svg class="ly-plane ly-over" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" data-ly-over>
              <path d={outline.join('')} class="ly-fill" data-ly-fill-basin />
              <path d={outline[0]} class="ly-outline" pathLength="1" data-ly-outline />
              <line x1="0" x2={W} y1="0" y2="0" class="ly-scan" data-ly-scan />
              <g data-ly-bipad>{bipadCells.map(([r, c]) => <g class="ly-pt" transform={`translate(${c + 0.5} ${r + 0.5})`}><circle r="2.6" class="ly-pt-ring" /><circle r="1.1" class="ly-pt-dot" /></g>)}</g>
            </svg>
          </div>
          <p class="ly-deal" data-ly-deal aria-hidden="true"></p>
          <div class="ly-keys" aria-hidden="true">
            <ul class="ly-key" data-ly-key>
              {zonal.map((z) => <li><span class="sw" style={`background:${rgb(HAZARD_RGB[z.class])}`}></span>{z.label}</li>)}
              <li class="ly-key-x" data-ly-key-bipad><span class="sw sw-dot"></span>BIPAD incident cell</li>
              <li class="ly-key-x" data-ly-key-meteor><span class="sw sw-meteor"></span>flooded by METEOR</li>
            </ul>
            <div class="ly-key ly-expo-key" data-ly-expokey><span>0%</span><span class="ly-expo-ramp"></span><span>100% of a cell's buildings in High hazard</span></div>
            <div class="ly-key ly-risk-key" data-ly-riskkey><span>R {meta.risk.range[0].toFixed(2)}</span><span class="ly-ramp"></span><span>{meta.risk.range[1].toFixed(2)}</span></div>
          </div>
        </div>

        <ol class="ly-panels" data-ly-panels>
          <li class="ly-panel" data-ly-panel="0">
            <h2><span>01</span> Area of interest</h2>
            <p class="ly-big"><span data-count={areaKm2} data-fmt="int">{int(Math.round(areaKm2))}</span> km²</p>
            <p>A HydroBASINS level 8 basin (ID {meta.aoi.hybasId}) on the upper Bagmati that contains the Kathmandu Valley. FloodHUB also takes a drawn rectangle or a district.</p>
          </li>
          <li class="ly-panel" data-ly-panel="1">
            <h2><span>02</span> Criteria</h2>
            <p class="ly-big"><span data-ly-dealt>11</span> of 11 layers</p>
            <p>Each factor is fetched on a 10 m grid and reclassified from 1, least flood-prone, to 5, most.</p>
            <ol class="ly-crit">{criteria.map((c, i) => <li data-ly-crit={i}>{c.label}</li>)}</ol>
          </li>
          <li class="ly-panel" data-ly-panel="2">
            <h2><span>03</span> Weighting</h2>
            <p>AHP pairwise comparison turns judgement into weights. Heavier layers stand further apart in the stack. These are the run's; drag one to recompute.</p>
            <fieldset class="ly-weights" data-ly-weights>
              <legend class="sr-only">Criterion weights</legend>
              {criteria.map((c, i) => (
                <label data-ly-label={i}>
                  <span class="ly-wname">{c.label}</span>
                  <span class="ly-wbar" aria-hidden="true"><span data-ly-wbar={i} style={`width:${((c.weight / wMax) * 100).toFixed(1)}%`}></span></span>
                  <input type="range" min="0" max="1000" value={Math.round(c.weight * 1000)} data-ly-w={i} aria-label={`Weight for ${c.label}`} />
                  <output data-ly-wout={i}>{pct(c.weight)}</output>
                </label>
              ))}
            </fieldset>
            <button type="button" class="ly-reset" data-ly-reset>Reset to the run's weights</button>
          </li>
          <li class="ly-panel" data-ly-panel="3">
            <h2><span>04</span> Compute</h2>
            <p class="ly-formula">R = (Σ wᵢ · classᵢ − 1) / 4</p>
            <p>Every cell's classes are summed with their weights and scaled to 0–1. Across this basin R runs from <span data-count={meta.risk.range[0]} data-fmt="2">{meta.risk.range[0].toFixed(2)}</span> to <span data-count={meta.risk.range[1]} data-fmt="2">{meta.risk.range[1].toFixed(2)}</span>.</p>
          </li>
          <li class="ly-panel" data-ly-panel="4">
            <h2><span>05</span> Vulnerability report</h2>
            <p>The surface is cut into hazard classes, and every OpenStreetMap building and population cell is tagged with its class.</p>
            <table class="ly-table">
              <thead><tr><th>Class</th><th>km²</th><th>People</th><th>Buildings</th></tr></thead>
              <tbody>{zonal.map((z, i) => <tr data-ly-row={i}><td><span class="sw" style={`background:${rgb(HAZARD_RGB[z.class])}`}></span>{z.label}</td><td data-count={z.areaKm2} data-fmt="int">{z.areaKm2.toFixed(0)}</td><td data-count={z.population} data-fmt="int">{int(z.population)}</td><td data-count={z.buildings} data-fmt="int">{int(z.buildings)}</td></tr>)}</tbody>
            </table>
            <p class="ly-note">No cell reaches Very High in this run. Population from HRSL.</p>
          </li>
          <li class="ly-panel" data-ly-panel="5">
            <h2><span>06</span> Validate</h2>
            <p>Checked against flood incidents recorded on the BIPAD Portal, 2011 to 2026: {val.observedCells} grid cells in this basin hold at least one. A curve above the diagonal means they fall where risk is ranked high.</p>
            <FloodChart curve={val.curve} auc={val.auc} label={val.label} />
          </li>
          <li class="ly-panel" data-ly-panel="6">
            <h2><span>07</span> Compare to METEOR</h2>
            <p>Against METEOR's modelled {met.returnPeriod.replace('1in', '1-in-')}-year river flood (fluvial, with defences). Share of each class that METEOR floods:</p>
            <ul class="ly-bars">
              {met.byClass.filter((b) => b.fraction !== null && b.pixels > 0).map((b, i) => (
                <li><span class="lb">{b.label}</span><span class="bar"><span data-ly-mbar={i} style={`width:${(((b.fraction ?? 0) / maxFrac) * 100).toFixed(1)}%;background:${rgb(HAZARD_RGB[b.class])}`}></span></span><span class="v">{pct(b.fraction ?? 0, 2)}</span></li>
              ))}
            </ul>
            <FloodChart curve={met.curve} auc={met.auc} label="METEOR 1-in-100-year fluvial (defended) flood" />
          </li>
          <li class="ly-panel" data-ly-panel="7">
            <h2><span>08</span> Shelters</h2>
            <p>Buildings are screened for size, hazard and data, then ranked for safety, access and service. The map shows each cell's share of buildings in High hazard.</p>
            <ul class="ly-funnel">
              {funnel.map((f, i) => (
                <li data-ly-frow={i}>
                  <span class="ly-fbar"><span style={`width:${logW(Math.max(f.n, 1)).toFixed(1)}%`}></span></span>
                  <span class="v" data-count={f.n} data-fmt="int">{int(f.n)}</span>
                  <span class="lb">{f.label}</span>
                </li>
              ))}
            </ul>
            <p class="ly-note">Bar lengths on a log scale. Sites are not mapped here: individual buildings stay off this site.</p>
          </li>
        </ol>
      </div>
    </div>
  </div>
  <details class="fig-desc ly-credits">
    <summary>Data credits</summary>
    <ul>{steps.credits.map((a: string) => <li>{a}</li>)}</ul>
  </details>
</FigureShell>

<style is:global>
  /* Rail: one progress bar per step */
  .ly-rail { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; margin-bottom: 1rem; background: var(--c-paper); }
  .ly-rail button { display: grid; gap: 0.25rem; width: 100%; padding: 0 0 0.375rem; border: 0; background: transparent; text-align: left; cursor: pointer; font-family: var(--font-jbmono); color: var(--c-ink-2); }
  .ly-rail-bar { display: block; height: 3px; background: var(--c-rule); overflow: hidden; }
  .ly-rail-fill { display: block; height: 100%; background: var(--c-accent); transform-origin: left; transform: scaleX(0); }
  .ly-rail .n { font-size: var(--text-xs); }
  .ly-rail .t { font-size: 0.6875rem; line-height: 1.25; }
  .ly-rail button[aria-current='step'] { color: var(--c-ink); }
  .ly-rail button:hover { color: var(--c-ink); }
  @media (max-width: 639px) { .ly-rail .t { display: none; } }

  .ly-grid { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 760px) { .ly-grid { grid-template-columns: 1.15fr 1fr; gap: 2.5rem; } }
  .ly-stage { display: grid; justify-items: center; perspective: 1300px; padding-top: 5rem; }
  @media (max-width: 759px) { .ly-stage { padding-top: 4rem; } }
  .ly-stack { --rx: 0deg; --rz: 0deg; position: relative; width: min(78vw, 400px); transform-style: preserve-3d; transform: rotateX(var(--rx)) rotateZ(var(--rz)); }
  .ly-plane { pointer-events: none; position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
  .ly-layer { transform: translateZ(var(--z, 0px)); }
  .ly-over { overflow: visible; image-rendering: auto; }
  .ly-fill { fill: var(--c-paper-2); }
  .ly-outline { fill: none; stroke: var(--c-ink); stroke-width: 0.6; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .ly-scan { stroke: var(--c-accent); stroke-width: 0.9; opacity: 0; }
  .ly-pt-ring { fill: none; stroke: var(--c-ink); stroke-width: 0.35; }
  .ly-pt-dot { fill: var(--c-ink); }
  .ly-pt { opacity: 0; }

  /* Default (no JS, reduced motion): hazard map with outline; extras hidden */
  .ly-layer, .ly-canvas, .ly-class, .ly-meteor, .ly-expo, .ly-scan, .ly-key-x, .ly-expo-key, .ly-risk-key { opacity: 0; }
  .ly-fill { opacity: 0; }

  .ly-deal { min-height: 1.5em; margin-top: 1rem; font-family: var(--font-jbmono); font-size: var(--text-sm); color: var(--c-accent-text); text-align: center; }
  .ly-keys { display: grid; justify-items: center; margin-top: 0.5rem; }
  .ly-keys > * { grid-area: 1 / 1; }
  .ly-key { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.25rem 1rem; font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-ink-2); }
  .ly-key li, .ly-table td:first-child { display: flex; align-items: center; gap: 0.375rem; }
  .sw { display: inline-block; width: 0.75rem; height: 0.75rem; outline: 1px solid var(--c-rule); }
  .sw-dot { border-radius: 50%; background: var(--c-ink); width: 0.5rem; height: 0.5rem; outline: none; }
  .sw-meteor { background: rgb(47 89 102 / 0.75); }
  .ly-expo-ramp, .ly-ramp { display: inline-block; width: 6rem; height: 8px; }
  .ly-expo-ramp { background: linear-gradient(90deg, rgb(236 231 220), rgb(196 146 120), rgb(126 52 40)); }
  .ly-ramp { background: linear-gradient(90deg, rgb(240 233 218), rgb(219 160 74), rgb(135 86 15), rgb(58 38 12)); }

  .ly-panels { display: grid; gap: 2rem; }
  .ly-panel h2 { display: flex; gap: 0.75rem; align-items: baseline; font-size: var(--text-lg); font-weight: 500; }
  .ly-panel h2 span { font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-accent-text); }
  .ly-panel p { margin-top: 0.5rem; font-size: var(--text-sm); }
  .ly-big { font-family: var(--font-jbmono); font-size: var(--text-2xl) !important; line-height: 1.1; color: var(--c-ink); font-variant-numeric: tabular-nums; }
  .ly-formula { font-family: var(--font-jbmono); font-size: var(--text-lg) !important; color: var(--c-ink); }
  .ly-note { color: var(--c-ink-2); font-size: var(--text-xs) !important; }
  .ly-crit { margin-top: 0.75rem; padding-left: 1.25rem; list-style: decimal; font-size: var(--text-sm); columns: 2; column-gap: 1.5rem; }
  .ly-crit li { transition: color var(--duration-fast) var(--ease-out); }
  .ly-crit li.is-now { color: var(--c-accent-text); }
  .ly-weights { margin-top: 0.75rem; border: 0; padding: 0; display: grid; gap: 0.125rem; }
  .ly-weights label { position: relative; display: grid; grid-template-columns: 9.5rem 1fr 3.25rem; align-items: center; gap: 0.5rem; font-size: var(--text-xs); }
  .ly-wbar { position: absolute; left: 10rem; right: 3.75rem; top: 50%; height: 6px; transform: translateY(-50%); pointer-events: none; }
  .ly-wbar span { display: block; height: 100%; background: var(--c-accent-wash); transform-origin: left; }
  .ly-weights input { position: relative; accent-color: var(--c-accent); min-height: 1.5rem; background: transparent; }
  .ly-weights output { font-family: var(--font-jbmono); text-align: right; font-variant-numeric: tabular-nums; }
  .ly-reset { display: none; margin-top: 0.5rem; padding: 0.25rem 0.625rem; border: 1px solid var(--c-rule-strong); border-radius: var(--radius-xs); background: transparent; color: var(--c-ink); font-family: var(--font-jbmono); font-size: var(--text-xs); cursor: pointer; }
  .js .ly-reset { display: inline-block; }
  .ly-table { margin-top: 0.75rem; width: 100%; border-collapse: collapse; font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .ly-table th { text-align: right; font-family: var(--font-jbmono); font-weight: 500; color: var(--c-ink-2); padding-bottom: 0.25rem; border-bottom: 1px solid var(--c-rule); }
  .ly-table th:first-child { text-align: left; }
  .ly-table td { padding-block: 0.3rem; text-align: right; border-bottom: 1px dashed var(--c-rule); }
  .ly-bars { margin: 0.75rem 0; display: grid; gap: 0.375rem; font-size: var(--text-xs); }
  .ly-bars li { display: grid; grid-template-columns: 5.5rem 1fr 3.5rem; align-items: center; gap: 0.5rem; }
  .ly-bars .bar { height: 0.75rem; background: var(--c-paper-2); }
  .ly-bars .bar span { display: block; height: 100%; transform-origin: left; }
  .ly-bars .v { font-family: var(--font-jbmono); text-align: right; font-variant-numeric: tabular-nums; }
  .ly-funnel { margin-top: 0.75rem; display: grid; gap: 0.5rem; }
  .ly-funnel li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.125rem 0.75rem; align-items: baseline; }
  .ly-funnel .ly-fbar { grid-column: 1 / -1; display: block; height: 0.625rem; background: var(--c-paper-2); }
  .ly-fbar span { display: block; height: 100%; background: var(--chart-model); transform-origin: left; }
  .ly-funnel li:last-child .ly-fbar span { background: var(--c-ink); }
  .ly-funnel .v { font-family: var(--font-jbmono); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .ly-funnel .lb { font-size: var(--text-xs); color: var(--c-ink-2); }
  .ly-credits ul { margin-top: 0.375rem; padding-left: 1rem; list-style: disc; font-size: var(--text-xs); }
  .ly-credits li + li { margin-top: 0.25rem; }

  /* With JS: one step at a time; panels slide in. Desktop pins the figure. */
  .js .ly-panel { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(14px); transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out), visibility 0s linear var(--duration-base); }
  .js .ly-panel.is-on { opacity: 1; visibility: visible; transform: none; transition: opacity var(--duration-base) var(--ease-out) 80ms, transform var(--duration-slow) var(--ease-out) 80ms; }
  .ly-pin.is-pinned { height: 680vh; }
  .ly-pin.is-pinned .ly-sticky { position: sticky; top: 0; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding-block: 1.5rem; }
  @media (max-width: 520px) { .ly-weights label { grid-template-columns: 1fr 5rem 3rem; } .ly-wbar { display: none; } .ly-crit { columns: 1; } }
</style>

<script>
  import { mountLayers } from './layers';
  document.addEventListener('astro:page-load', () => {
    const fig = document.getElementById('fig-layers');
    if (fig) mountLayers(fig);
  });
</script>
