---
/**
 * Fig. 6, FloodHUB: "Layers to risk". Real data from a cached FloodHUB run for the upper
 * Bagmati basin (HydroBASINS level 8). Eleven reclassified criterion layers stand in an
 * exploded stack; scrolling collapses them into the AHP-weighted risk surface. The sliders
 * start at that run's weights (recovered exactly from the cached surface) and recompute
 * the surface in the browser with FloodHUB's own formula. No backend calls.
 */
import FigureShell from './FigureShell.astro';
import { buildLayers } from '../../lib/schematic/floodhub-layers';

const { W, H, criteria, layerPngs, riskPng, meta } = buildLayers();
const pct = (w: number) => `${(w * 100).toFixed(1)}%`;
const top3 = criteria.slice(0, 3).map((c) => `${c.label.toLowerCase()} (${pct(c.weight)})`).join(', ');
const cached = meta.source.match(/cached (\d{4}-\d{2}-\d{2})/)?.[1] ?? '';

const description =
  `Eleven flood-susceptibility criteria for the upper Bagmati basin, each reclassified into five classes, are stacked and combined into one risk surface by a weighted sum. ` +
  `The weights are those of a FloodHUB run from ${cached}; the three largest are ${top3}. ` +
  `Risk is highest along the valley floor and river corridors and lowest on the forested ridges. ` +
  `Moving a slider recomputes the surface with FloodHUB's formula, R = (sum of weight times class − 1) / 4. Layers are averaged to ${meta.aoi.resolutionM} m cells for the web.`;
---

<FigureShell
  id="fig-layers"
  number={6}
  title="Layers to risk"
  caption={`Eleven criterion layers for the upper Bagmati basin (HydroBASINS level 8, ID ${meta.aoi.hybasId}), each reclassified to five susceptibility classes, collapse into one flood-risk surface by AHP-weighted sum. The sliders start at the weights of a FloodHUB run from ${cached}; move them to recompute the surface in your browser. Shown at ${meta.aoi.resolutionM} m cells; FloodHUB computes at ${meta.grid.nativeResolutionM} m.`}
  data={`FloodHUB computation (${cached}): Copernicus GLO-30 DEM, ESA WorldCover 2021, Sentinel-2 NDVI, CHIRPS, HRSL population, OpenStreetMap; credits below`}
  status="simulated"
  description={description}
  class="ly"
>
  <div class="ly-grid">
    <div class="ly-stage" data-ly-stage>
      <div class="ly-stack" data-ly-stack style={`aspect-ratio:${W}/${H}`}>
        {layerPngs.map((_, i) => (
          <img class="ly-layer" width={W} height={H} alt="" data-ly-layer={i} style={`--k:${criteria.length - i}`} />
        ))}
        <img class="ly-risk" src={riskPng} width={W} height={H} alt="" data-ly-risk-img />
        <canvas class="ly-risk ly-canvas" width={W} height={H} data-ly-canvas aria-hidden="true"></canvas>
      </div>
    </div>

    <div class="ly-side">
      <fieldset class="ly-weights" data-ly-weights>
        <legend>Criteria, top of stack first, with weights</legend>
        {criteria.map((c, i) => (
          <label data-ly-label={i}>
            <span class="ly-wname">{c.label}</span>
            <input type="range" min="0" max="1000" value={Math.round(c.weight * 1000)} data-ly-w={i} aria-label={`Weight for ${c.label}`} />
            <output data-ly-wout={i}>{pct(c.weight)}</output>
          </label>
        ))}
      </fieldset>
      <button type="button" class="ly-reset" data-ly-reset>Reset to the run's weights</button>
      <div class="ly-scale" aria-hidden="true"><span>lower risk</span><span class="ly-ramp"></span><span>higher risk</span></div>
    </div>
  </div>
  <details class="fig-desc ly-credits">
    <summary>Data credits</summary>
    <ul>{meta.attribution.map((a: string) => <li>{a}</li>)}</ul>
  </details>
</FigureShell>

<style is:global>
  .ly-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 760px) { .ly-grid { grid-template-columns: 1fr 1fr; } }
  .ly-stage { perspective: 1200px; display: grid; place-items: center; min-height: 380px; }
  .ly-stack { position: relative; width: min(52vw, 250px); transform-style: preserve-3d; transform: rotateX(56deg) rotateZ(-38deg); }
  .ly-layer, .ly-risk {
    position: absolute; inset: 0; width: 100%; height: 100%;
    image-rendering: pixelated;
    transform: translateZ(calc(var(--k, 0) * var(--gap, 0px)));
  }
  .ly-risk { --k: 0; }
  .ly-canvas { opacity: 0; }
  .ly.is-live .ly-canvas { opacity: var(--risk-o, 1); }
  .ly.is-live [data-ly-risk-img] { opacity: 0; }
  /* Exploded state with JS; without JS the combined risk surface shows alone. */
  .js .ly-stack { --gap: 20px; }
  .ly-layer { opacity: 0; }
  .js .ly-layer { opacity: 1; }

  .ly-weights { border: 0; padding: 0; display: grid; gap: 0.125rem; }
  .ly-weights legend { font-family: var(--font-jbmono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-ink-2); margin-bottom: 0.5rem; }
  .ly-weights label { display: grid; grid-template-columns: 11rem 1fr 3.5rem; align-items: center; gap: 0.75rem; font-size: var(--text-sm); transition: opacity var(--duration-base) var(--ease-out); }
  .ly-weights input { accent-color: var(--c-accent); min-height: 1.75rem; }
  .ly-weights input:disabled { opacity: 0.5; }
  .ly-weights output { font-family: var(--font-jbmono); font-size: var(--text-xs); text-align: right; font-variant-numeric: tabular-nums; }
  .ly-reset { display: none; margin-top: 0.75rem; padding: 0.25rem 0.625rem; border: 1px solid var(--c-rule-strong); border-radius: var(--radius-xs); background: transparent; color: var(--c-ink); font-family: var(--font-jbmono); font-size: var(--text-xs); cursor: pointer; }
  .js .ly-reset { display: inline-block; }
  .ly-scale { display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem; font-family: var(--font-jbmono); font-size: var(--text-xs); color: var(--c-ink-2); }
  .ly-ramp { flex: 1; height: 8px; background: linear-gradient(90deg, rgb(240 233 218), rgb(219 160 74), rgb(135 86 15), rgb(58 38 12)); outline: 1px solid var(--c-rule); }
  .ly-credits ul { margin-top: 0.375rem; padding-left: 1rem; list-style: disc; font-size: var(--text-xs); }
  .ly-credits li + li { margin-top: 0.25rem; }
  @media (max-width: 520px) { .ly-weights label { grid-template-columns: 1fr 5rem 3rem; } }
</style>

<script>
  import { mountLayers } from './layers';
  document.addEventListener('astro:page-load', () => {
    const fig = document.getElementById('fig-layers');
    if (fig) mountLayers(fig);
  });
</script>
